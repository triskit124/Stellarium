# Meson build override for doxygen-awesome-css.
# Provides the source directory path so the parent build can pass it
# to the Doxyfile template as AWESOME_CSS_DIR.
project('doxygen-awesome-css', version: '2.0.0')

doxygen_awesome_css_source_dir = meson.current_source_dir()
doxygen_awesome_css_dep = declare_dependency()
