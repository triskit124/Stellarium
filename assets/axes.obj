# 3D coordinate axes
# X = red, Y = green, Z = blue
# Each axis is a thin box from origin to 1.0 along its direction

mtllib axes.mtl

# X-axis vertices (box from origin along +X)
v 0.000000 -0.020000 -0.020000
v 1.000000 -0.020000 -0.020000
v 1.000000  0.020000 -0.020000
v 0.000000  0.020000 -0.020000
v 0.000000 -0.020000  0.020000
v 1.000000 -0.020000  0.020000
v 1.000000  0.020000  0.020000
v 0.000000  0.020000  0.020000

# Y-axis vertices (box from origin along +Y)
v -0.020000 0.000000 -0.020000
v  0.020000 0.000000 -0.020000
v  0.020000 1.000000 -0.020000
v -0.020000 1.000000 -0.020000
v -0.020000 0.000000  0.020000
v  0.020000 0.000000  0.020000
v  0.020000 1.000000  0.020000
v -0.020000 1.000000  0.020000

# Z-axis vertices (box from origin along +Z)
v -0.020000 -0.020000 0.000000
v  0.020000 -0.020000 0.000000
v  0.020000  0.020000 0.000000
v -0.020000  0.020000 0.000000
v -0.020000 -0.020000 1.000000
v  0.020000 -0.020000 1.000000
v  0.020000  0.020000 1.000000
v -0.020000  0.020000 1.000000

# Normals
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0

# X-axis (red)
usemtl Red
f 5//5 6//5 7//5 8//5
f 1//6 4//6 3//6 2//6
f 1//2 5//2 8//2 4//2
f 2//1 3//1 7//1 6//1
f 4//3 8//3 7//3 3//3
f 1//4 2//4 6//4 5//4

# Y-axis (green)
usemtl Green
f 13//5 14//5 15//5 16//5
f  9//6 12//6 11//6 10//6
f  9//2 13//2 16//2 12//2
f 10//1 11//1 15//1 14//1
f 12//3 16//3 15//3 11//3
f  9//4 10//4 14//4 13//4

# Z-axis (blue)
usemtl Blue
f 21//5 22//5 23//5 24//5
f 17//6 20//6 19//6 18//6
f 17//2 21//2 24//2 20//2
f 18//1 19//1 23//1 22//1
f 20//3 24//3 23//3 19//3
f 17//4 18//4 22//4 21//4